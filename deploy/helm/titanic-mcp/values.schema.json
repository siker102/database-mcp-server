{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "database", "existingSecrets"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "replicaCount": {"type": "integer", "minimum": 1},
    "database": {
      "type": "object",
      "required": ["host", "port", "name", "sslmode"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "name": {"type": "string", "minLength": 1},
        "sslmode": {"enum": ["disable", "require", "verify-ca", "verify-full"]},
        "caSecret": {"type": "string"},
        "ownerUser": {"type": "string"},
        "appUser": {"type": "string"},
        "sqlUser": {"type": "string"}
      }
    },
    "existingSecrets": {
      "type": "object",
      "required": ["database", "apiKeys"],
      "properties": {
        "database": {"type": "string", "minLength": 1},
        "apiKeys": {"type": "string", "minLength": 1}
      }
    },
    "dbInit": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "createRoles": {"type": "boolean"},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 30}
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "logLevel": {"enum": ["DEBUG", "INFO", "WARNING", "ERROR"]},
        "allowedHosts": {"type": "array", "items": {"type": "string"}},
        "allowedOrigins": {"type": "array", "items": {"type": "string"}},
        "rateLimitPerMinute": {"type": "integer", "minimum": 1},
        "rateLimitBurst": {"type": "integer", "minimum": 1},
        "sqlTimeoutSeconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
        "sqlMaxConcurrency": {"type": "integer", "minimum": 1, "maximum": 32},
        "clientIpHeader": {"type": "string"}
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "host": {"type": "string"},
        "tlsSecretName": {"type": "string"},
        "annotations": {"type": "object"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressNamespace": {"type": "string"},
        "monitoringNamespace": {"type": "string"},
        "databaseCidr": {"type": "string"}
      }
    }
  }
}
