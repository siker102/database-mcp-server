{
  // Dev container for Windows (Docker Desktop) and GitHub Codespaces. See ADR 0007.
  "name": "titanic-mcp",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    // Official features from github.com/devcontainers/features, pinned to exact versions.
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1.3.1": {
      "version": "none",
      "helm": "3.19.0",
      "minikube": "none"
    }
  },
  "containerEnv": {
    // Keep the Linux venv outside the bind-mounted workspace: faster on Windows and no clash
    // with a .venv created on the Windows host.
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv",
    "UV_LINK_MODE": "copy"
  },
  "forwardPorts": [8000],
  "postCreateCommand": "make install && uv run pre-commit install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "ms-kubernetes-tools.vscode-kubernetes-tools"
      ]
    }
  }
}
