# Example configuration. `make up` creates a real .env with random passwords if it is missing.
# Never put real secrets into this file; .env is gitignored.

# Database connection (shared by all roles)
DBMCP_DB_HOST=localhost
DBMCP_DB_PORT=5432
DBMCP_DB_NAME=titanic
# verify-full is the default; only the local Compose stack disables TLS explicitly.
DBMCP_DB_SSLMODE=verify-full
# DBMCP_DB_SSLROOTCERT=/etc/database-mcp/db-ca.crt

# db-init (owner role; app/sql passwords only needed with --create-roles)
DBMCP_DB_OWNER_USER=titanic_owner
DBMCP_DB_OWNER_PASSWORD=
DBMCP_DB_APP_USER=titanic_app
DBMCP_DB_APP_PASSWORD=
DBMCP_DB_SQL_USER=titanic_sql
DBMCP_DB_SQL_PASSWORD=
DBMCP_DATA_FILE=data/titanic.csv

# Server
DBMCP_HOST=127.0.0.1
DBMCP_PORT=8000
DBMCP_METRICS_PORT=9090
DBMCP_LOG_LEVEL=INFO
DBMCP_API_KEYS_FILE=secrets/api_keys.json
# JSON lists. Host header values the server accepts (DNS-rebinding protection).
DBMCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*"]
DBMCP_ALLOWED_ORIGINS=[]
DBMCP_RATE_LIMIT_PER_MINUTE=60
DBMCP_RATE_LIMIT_BURST=20
DBMCP_SQL_TIMEOUT_SECONDS=5
DBMCP_SQL_MAX_CONCURRENCY=4
DBMCP_CLIENT_IP_HEADER=x-forwarded-for
