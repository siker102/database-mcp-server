# Example configuration. `make up` creates a real .env with random passwords if it is missing.
# Never put real secrets into this file; .env is gitignored.

# Database connection (shared by all roles)
TMCP_DB_HOST=localhost
TMCP_DB_PORT=5432
TMCP_DB_NAME=titanic
# verify-full is the default; only the local Compose stack disables TLS explicitly.
TMCP_DB_SSLMODE=verify-full
# TMCP_DB_SSLROOTCERT=/etc/titanic-mcp/db-ca.crt

# db-init (owner role; app/sql passwords only needed with --create-roles)
TMCP_DB_OWNER_USER=titanic_owner
TMCP_DB_OWNER_PASSWORD=
TMCP_DB_APP_USER=titanic_app
TMCP_DB_APP_PASSWORD=
TMCP_DB_SQL_USER=titanic_sql
TMCP_DB_SQL_PASSWORD=
TMCP_DATA_FILE=data/titanic.csv

# Server
TMCP_HOST=127.0.0.1
TMCP_PORT=8000
TMCP_METRICS_PORT=9090
TMCP_LOG_LEVEL=INFO
TMCP_API_KEYS_FILE=secrets/api_keys.json
# JSON lists. Host header values the server accepts (DNS-rebinding protection).
TMCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*"]
TMCP_ALLOWED_ORIGINS=[]
TMCP_RATE_LIMIT_PER_MINUTE=60
TMCP_RATE_LIMIT_BURST=20
TMCP_SQL_TIMEOUT_SECONDS=5
TMCP_SQL_MAX_CONCURRENCY=4
TMCP_CLIENT_IP_HEADER=x-forwarded-for
